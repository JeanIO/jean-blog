{
  "name": "learn-node",
  "version": "1.0.0",
  "description": "这是一个通过实践掌握Node.js http模块和HTTP协议的学习项目。每个关卡包含一个明确的目标、相关知识点和实现要求。",
  "main": "app.ts",
  "scripts": {
    "start": "NODE_ENV=production tsx watch ./app.ts",
    "dev": "NODE_ENV=development nodemon --inspect --exec tsx app.ts",
    "devCheck": "tsc --noEmit --watch",
    "build": "tsc && cp .env dist/",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@koa/multer": "^4.0.0",
    "@koa/router": "^14.0.0",
    "axios": "^1.13.2",
    "dotenv": "^17.2.3",
    "ioredis": "^6.0.0",
    "koa": "^3.1.1",
    "koa-bodyparser": "^4.4.1",
    "koa-router": "^14.0.0",
    "koa-static": "^5.0.0",
    "multer": "^2.0.2",
    "mysql2": "^3.15.3",
    "qcloud-cos-sts": "^3.1.3"
  },
  "devDependencies": {
    "@types/koa": "^2.15.0",
    "@types/koa__router": "^12.0.4",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/koa-static": "^4.0.4",
    "@types/node": "^22.0.0",
    "nodemon": "^3.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
